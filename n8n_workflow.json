    {
      "parameters": {
        "jsCode": "const facilities = $input.all(); \n\n// 篩選出 line_group_id 為空（尚未綁定）的一輪機構\nconst unboundFacs = facilities.filter(fac => {\n  const lgid = fac.json.line_group_id;\n  return !lgid || lgid.toString().trim() === \"\";\n});\n\n// 建立 3 行一排的按鈕網格\nconst buttons = [];\nlet currentRow = {\n  \"type\": \"box\",\n  \"layout\": \"horizontal\",\n  \"spacing\": \"sm\",\n  \"contents\": []\n};\n\nunboundFacs.forEach((fac, index) => {\n  const shortName = fac.json.short_name;\n  if (!shortName) return;\n  \n  currentRow.contents.push({\n    \"type\": \"button\",\n    \"action\": {\n      \"type\": \"message\",\n      \"label\": shortName,\n      \"text\": shortName\n    },\n    \"style\": \"secondary\",\n    \"height\": \"sm\",\n    \"color\": \"#1F4E79\"\n  });\n\n  if (currentRow.contents.length === 3 || index === unboundFacs.length - 1) {\n    buttons.push(currentRow);\n    currentRow = {\n      \"type\": \"box\",\n      \"layout\": \"horizontal\",\n      \"spacing\": \"sm\",\n      \"contents\": []\n    };\n  }\n});\n\nif (buttons.length === 0) {\n  buttons.push({\n    \"type\": \"text\",\n    \"text\": \"目前所有一輪合作機構皆已完成綁定。\",\n    \"align\": \"center\",\n    \"color\": \"#999999\"\n  });\n}\n\nconst flexJson = {\n  \"type\": \"bubble\",\n  \"size\": \"mega\",\n  \"body\": {\n    \"type\": \"box\",\n    \"layout\": \"vertical\",\n    \"spacing\": \"md\",\n    \"contents\": [\n      {\n        \"type\": \"text\",\n        \"text\": \"🏥 萬芳醫院轉介平台\",\n        \"weight\": \"bold\",\n        \"size\": \"xl\",\n        \"color\": \"#1F4E79\"\n      },\n      {\n        \"type\": \"text\",\n        \"text\": \"請直接點選下方對應的按鈕，即可自動完成此 LINE 群組的綁定：\",\n        \"wrap\": true,\n        \"size\": \"sm\",\n        \"color\": \"#666666\"\n      },\n      {\n        \"type\": \"separator\",\n        \"margin\": \"md\"\n      },\n      {\n        \"type\": \"box\",\n        \"layout\": \"vertical\",\n        \"spacing\": \"sm\",\n        \"contents\": buttons\n      }\n    ]\n  }\n};\n\nreturn [{ json: { flexJson } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -440,
        -200
      ],
